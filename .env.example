PORT=2567
# One live room per Space; full Spaces reject entry. Shared runtime limit for all Spaces.
# SPACE_MAX_CLIENTS=32
# Local development secret only. Use a random secret with at least 32 characters in production.
IDENTITY_SECRET=development-only-identity-secret-change-before-production
# In production set this to the public site origin, e.g. https://workspace.example.com
IDENTITY_BASE_URL=http://localhost:5173
# In production replace this list with only the deployed frontend origin(s).
IDENTITY_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:2567,http://127.0.0.1:2567,http://127.0.0.1:2568
# Defaults resolve to project-root data/world.sqlite and assets/maps/registry.json.
# DATABASE_PATH=/absolute/path/to/world.sqlite
# MAP_REGISTRY_PATH=/absolute/path/to/registry.json
# Custom Space/map deployment and separate static cover mounts: docs/hosting.md.
# Public browser URLs for tools already deployed on your host; restart backend after changes.
# Keep {} to leave the map entries unconfigured. Use the tools' own access controls.
# URLs are returned publicly by /api/tools: do not put credentials or private tokens here.
EXTERNAL_TOOLS={}
# EXTERNAL_TOOLS maps Tiled resourceId values to web page URLs. URL is required.
# Example (replace domains/paths with actual pages, not Docker-internal addresses):
# EXTERNAL_TOOLS='{"shared-canvas":{"url":"https://board.example.com/boards/workspace"},"shared-drawing":{"url":"https://draw.example.com/"},"lounge-screen":{"url":"https://watch.example.com/"},"shared-document":{"url":"https://docs.example.com/p/workspace"}}'
# Optional mode is embed or external (default). Entering a zone only shows the open control.
# An embed opens on click; manualExternalOpen adds a separate manual link after opening.
# allowSameOrigin defaults to false; enable it only for a trusted self-hosted tool.
# EXTERNAL_TOOLS='{"shared-canvas":{"url":"https://board.example.com/boards/workspace","mode":"embed","manualExternalOpen":true}}'
# Browser endpoint defaults to the current origin via Vite proxy.
# Optional Colyseus server URL; identity API requests remain same-origin at /api.
# VITE_SERVER_URL=http://127.0.0.1:2567
# Proximity voice uses browser-to-browser WebRTC audio. This JSON is returned
# to browsers by /api/voice-config; do not put long-lived TURN credentials here.
# Use a TURN provider with short-lived credentials when relay access is needed.
VOICE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
# Voice is opt-in in the browser. Peers connect within 160px and disconnect
# beyond 192px (hysteresis), with at most 6 peers per client.
VOICE_CONNECT_RADIUS=160
VOICE_DISCONNECT_RADIUS=192
VOICE_MAX_PEERS=6
# Re-evaluate nearby peers once per second.
VOICE_SCAN_INTERVAL_MS=1000
