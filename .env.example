PORT=2567
# Local development secret only. Use a random secret with at least 32 characters in production.
IDENTITY_SECRET=development-only-identity-secret-change-before-production
# In production set this to the public site origin, e.g. https://workspace.example.com
IDENTITY_BASE_URL=http://localhost:5173
# In production replace this list with only the deployed frontend origin(s).
IDENTITY_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:2567,http://127.0.0.1:2567,http://127.0.0.1:2568
# Defaults resolve to project-root data/world.sqlite and assets/maps/registry.json.
# DATABASE_PATH=/absolute/path/to/world.sqlite
# MAP_REGISTRY_PATH=/absolute/path/to/registry.json
# Public browser URLs for tools already deployed on your host; restart backend after changes.
# Keep {} to leave the map entries unconfigured. Use the tools' own access controls.
# URLs are returned publicly by /api/tools: do not put credentials or private tokens here.
EXTERNAL_TOOLS={}
# Legacy kind/url entries default to the external presentation mode.
# Example (replace domains/paths with actual tool pages, not Docker-internal addresses):
# EXTERNAL_TOOLS='{"shared-canvas":{"kind":"whiteboard","url":"https://board.example.com/boards/workspace"},"shared-drawing":{"kind":"drawing","url":"https://draw.example.com/"},"lounge-screen":{"kind":"media","url":"https://watch.example.com/"},"shared-document":{"kind":"document","url":"https://docs.example.com/p/workspace"}}'
# Optional presentation configuration: mode may be native, overlay, embed, external, or adapter.
# Adapter IDs must be registered by the client; fallback is used if the adapter is unavailable.
# EXTERNAL_TOOLS='{"shared-canvas":{"kind":"whiteboard","url":"https://board.example.com/boards/workspace","mode":"adapter","adapterId":"whiteboard","fallback":"external"}}'
# Browser endpoint defaults to the current origin via Vite proxy.
# Optional Colyseus server URL; identity API requests remain same-origin at /api.
# VITE_SERVER_URL=http://127.0.0.1:2567
