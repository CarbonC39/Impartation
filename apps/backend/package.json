{
  "name": "@virtual-workspace/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env build/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "identity": "tsx --env-file-if-exists=../../.env src/identity-cli.ts"
  },
  "dependencies": {
    "@colyseus/core": "~0.18.18",
    "@colyseus/tools": "~0.18.7",
    "@colyseus/ws-transport": "~0.18.4",
    "@virtual-workspace/shared": "*",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@colyseus/sdk": "~0.18.5",
    "@colyseus/testing": "~0.18.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}
