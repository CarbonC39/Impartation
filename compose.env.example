# Browser origin for Impartation. With the default Compose file, open
# http://localhost:2567 on the Docker host. For remote users, provide HTTPS
# through your own proxy or enable Caddy below and use https://your-domain.
VW_ORIGIN=http://localhost:2567

# Want Caddy HTTPS? Uncomment this, point DNS at the host, and change VW_ORIGIN
# to https://the-same-hostname.
# VW_HOST=workspace.example.com

# Want a shared browser? Uncomment these with Neko and its Caddy route.
# BROWSER_HOST=browser.example.com

# Want coturn or Neko? Uncomment the public IPv4 that clients can reach.
# PUBLIC_IP=203.0.113.10

# Generate with e.g.:
# openssl rand -hex 32
IDENTITY_SECRET=replace-with-a-random-secret-at-least-32-characters

# open | code | admin
REGISTRATION_MODE=code
REGISTRATION_CODE=replace-with-your-registration-code

SPACE_MAX_CLIENTS=32

# Proximity voice uses 320px to connect and 384px to disconnect by default.
# Override these values to tune the voice range for the deployment.
VOICE_CONNECT_RADIUS=320
VOICE_DISCONNECT_RADIUS=384

# Want TURN voice relay? Uncomment these with coturn and backend VOICE_TURN_*.
# TURN_SHARED_SECRET=replace-with-another-random-secret-at-least-32-characters
# TURN_CREDENTIAL_TTL=3600

# Want collaborative documents? Uncomment these with Etherpad/PostgreSQL.
# ETHERPAD_DB_PASSWORD=replace-with-a-random-database-password
# ETHERPAD_ADMIN_PASSWORD=replace-with-a-random-admin-password

# Want a shared browser? Uncomment both passwords with Neko.
# NEKO_USER_PASSWORD=replace-with-a-user-password
# NEKO_ADMIN_PASSWORD=replace-with-a-different-admin-password
